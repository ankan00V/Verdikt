# =============================================================================
# Verdikt — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# See README.md for where to get each key.
# =============================================================================

# REQUIRED — Groq API key pool (LLM inference).
# Comma-separated. Each retry advances to the next key, so a per-key rate limit
# costs one attempt instead of failing the request. One key is fine too.
# Get them from: https://console.groq.com → API Keys
GROQ_API_KEYS=gsk_your_first_key_here,gsk_your_second_key_here

# OPTIONAL — the two models used. Attempts alternate between them, so the
# fallback is a genuinely different model rather than the same one retried.
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# REQUIRED — Tavily API Key (for news and web research)
# Get it from: https://tavily.com → Sign up → API Key
TAVILY_API_KEY=your_tavily_key_here

# OPTIONAL — Upstash Redis (for persistent checkpointing on Vercel)
# Get it from: https://upstash.com → Create Database → REST API
# Not needed for local development, only for Vercel deployment
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — Yahoo Finance Proxy (needed on Vercel to bypass IP blocks)
# Get free proxies from: https://webshare.io → Proxy List
# Format: http://username:password@ip:port
YAHOO_PROXY_URL=

# RESERVED — mock-data flag. Declared but NOT yet implemented; no code reads it.
USE_MOCK_DATA=false
